create_clock -name sys_clk -period 20.000 -waveform {0.000 10.000} [get_ports {sys_clk}]
create_clock -name eth_rx_clk -period 8.000 -waveform {0.000 4.000} [get_ports {eth_rx_clk}]
create_generated_clock -name pixel_clk_5x -source [get_ports {sys_clk}] -master_clock sys_clk -multiply_by 2.5 [get_nets {pixel_clk_5x}]
create_generated_clock -name pixel_clk -source [get_ports {sys_clk}] -master_clock sys_clk -divide_by 2 [get_nets {pixel_clk}]
create_generated_clock -name mem_clk -source [get_ports {sys_clk}] -master_clock sys_clk -divide_by 1.25 -phase 0 [get_pins {u_mem_pll/pll_inst.clkc[1]}]
set_false_path -from [get_ports {key4_n key1_n key2_n}]
set_false_path -to [get_regs -hier {u_eth/rx_meta}]
set_false_path -to [get_regs -hier {u_eth/send_meta}]
set_false_path -to [get_regs -hier {u_eth/done_meta}]
set_false_path -to [get_regs -hier {u_eth/rx_cmd_meta[*]}]
set_false_path -to [get_regs -hier {u_eth/rx_seq_meta[*]}]
set_false_path -to [get_regs -hier {u_eth/rx_count_meta[*]}]
set_false_path -to [get_regs -hier {u_eth/command_meta[*]}]
set_false_path -to [get_regs -hier {u_eth/sequence_meta[*]}]
set_false_path -to [get_regs -hier {u_video/u_frames/ack_meta}]
set_false_path -to [get_regs -hier {u_video/u_frames/ready_meta}]
set_false_path -to [get_regs -hier {u_video/u_frames/bank_meta}]
set_false_path -to [get_regs -hier {u_phy/symbols_sync1[*]}]
set_false_path -to [get_regs -hier {u_phy/toggle_sync1}]
set_max_delay -from [get_clocks {pixel_clk_5x}] -to [get_ports {HDMI_CLK_P HDMI_D0_P HDMI_D1_P HDMI_D2_P}] 8.000 -datapath_only

# RGMII board-level input/output timing remains to be characterized against
# the PHY TXC/RXC delay settings. Diagnostic signals (rx_ddr_active, rx_crc_pass,
# rx_frame_valid) are internal and require no I/O timing constraints.
